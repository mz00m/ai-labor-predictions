{
  "name": "ai-labor-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "capability:refresh": "tsx scripts/fetch-capability.ts",
    "prebuild:public-data": "tsx scripts/copy-public-data.ts",
    "build:stats": "tsx scripts/generate-site-stats.ts",
    "build": "npm run build:stats && npm run prebuild:public-data && npm run compile-wiki && npm run compile-kb && npm run build:search && next build",
    "start": "next start",
    "lint": "next lint",
    "digest": "tsx scripts/generate-digest.ts",
    "digest:14": "tsx scripts/generate-digest.ts --days 14",
    "digest:fetch": "tsx scripts/fetch-sources.ts",
    "digest:synthesize": "tsx scripts/synthesize-digest.ts",
    "digest:pipeline": "tsx scripts/fetch-sources.ts && tsx scripts/synthesize-digest.ts",
    "digest:dry-run": "tsx scripts/fetch-sources.ts && tsx scripts/synthesize-digest.ts --dry-run",
    "ingest": "tsx scripts/ingest-source.ts",
    "ingest:from-digest": "tsx scripts/ingest-from-digest.ts",
    "ingest:apply": "tsx scripts/apply-ingestion.ts && npm run build:stats && npm run compile-wiki && npm run compile-kb",
    "backfill:content": "tsx scripts/backfill-source-content.ts --skip-existing",
    "build:search": "tsx scripts/build-search-index.ts",
    "build:risk": "tsx scripts/build-occupation-risk.ts",
    "build:oews-state": "python3 scripts/fetch_oews_state.py",
    "build:oews-msa": "python3 scripts/fetch_oews_msa.py",
    "build:oews-bos": "python3 scripts/fetch_oews_bos.py",
    "build:openai-signals": "python3 scripts/build_openai_signals.py",
    "build:realized-exposure": "python3 scripts/build_realized_exposure.py",
    "backfill:canonicalize-emails": "tsx scripts/backfill-canonicalize-emails.ts",
    "build:acs-county": "python3 scripts/fetch_acs_county.py",
    "build:cbsa-crosswalk": "python3 scripts/fetch_cbsa_crosswalk.py",
    "build:cbsa-summary": "python3 scripts/build_micro_summary.py",
    "build:state-risk": "tsx scripts/build-state-risk.ts",
    "build:state-svg": "tsx scripts/build-state-svg-paths.ts",
    "build:county-msa-svg": "tsx scripts/build-county-msa-svg-paths.ts",
    "backfill:content:dry-run": "tsx scripts/backfill-source-content.ts --dry-run",
    "fetch:article": "tsx scripts/fetch-article.ts",
    "fetch:pdf": "tsx scripts/fetch-article.ts --pdf",
    "signals:fetch": "python3 scripts/signals/fetch_all.py",
    "signals:calc": "python3 scripts/signals/calculate_metrics.py",
    "signals:update": "python3 scripts/signals/fetch_all.py",
    "agent:research": "tsx scripts/agent-research.ts",
    "agent:review": "tsx scripts/agent-review.ts",
    "compile-kb": "tsx scripts/compile-knowledge-base.ts",
    "compile-wiki": "tsx scripts/compile-wiki.ts",
    "test-assessments": "set -a && . ./.env.local && set +a && tsx scripts/test-assessments.ts",
    "ask": "tsx scripts/ask.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@neondatabase/serverless": "^1.0.2",
    "@stripe/stripe-js": "^9.0.1",
    "@types/jspdf": "^1.3.3",
    "@vercel/analytics": "^1.6.1",
    "date-fns": "^3.6.0",
    "jose": "^6.2.2",
    "jspdf": "^4.2.1",
    "mammoth": "^1.12.0",
    "next": "^14.2.0",
    "pdf-parse": "^2.4.5",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "recharts": "^2.12.0",
    "resend": "^6.12.0",
    "stripe": "^21.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.141",
    "@mozilla/readability": "^0.6.0",
    "@types/d3-geo": "^3.1.0",
    "@types/jsdom": "^28.0.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.0",
    "d3-geo": "^3.1.1",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "jsdom": "^28.1.0",
    "postcss": "^8.4.0",
    "puppeteer-core": "^24.43.1",
    "tailwindcss": "^3.4.0",
    "topojson-client": "^3.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.5.0",
    "us-atlas": "^3.0.1",
    "vitest": "^4.1.2"
  }
}
