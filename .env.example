# Research Pipeline API Keys
# ===========================

# Anthropic - Required for source ingestion (scripts/ingest-source.ts)
# Get a key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Scopus (Elsevier) - Primary academic search
# Get a key at: https://dev.elsevier.com/
SCOPUS_API_KEY=

# CORE.ac.uk - Open access full-text search
# Register at: https://core.ac.uk/services/api
CORE_API_KEY=

# Job Postings (Adzuna) - Optional, falls back to curated data
# Register at: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Social Media Scanning (all optional)
# =====================================

# Twitter/X API v2 - Optional, $100/mo Basic tier
# Get a bearer token at: https://developer.x.com/
TWITTER_BEARER_TOKEN=

# Google Custom Search - Optional, 100 free queries/day
# Set up at: https://programmablesearchengine.google.com/
# NOTE: The digest pipeline's `ssrn` adapter also runs on these keys
# (queries `site:ssrn.com` via Google CSE). Without them, both `googleCse`
# and `ssrn` adapters silently return zero items.
GOOGLE_CSE_KEY=
GOOGLE_CSE_ID=

# BLS (Bureau of Labor Statistics) - Required for digest pipeline `bls` adapter
# Free key, register at: https://data.bls.gov/registrationEngine/
BLS_API_KEY=

# FRED (St. Louis Fed) - Required for digest pipeline `fred` adapter
# Free key, register at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Semantic Scholar - Recommended for digest pipeline `semanticScholar` adapter
# Without a key, free tier is heavily rate-limited (429s). Request at:
# https://www.semanticscholar.org/product/api#api-key-form
SEMANTIC_SCHOLAR_API_KEY=

# Assessment Auth
# =======================
# Neon PostgreSQL — required in production for assessments and durable rate limits
DATABASE_URL=

# Resend - Email verification codes for assessment dashboard
# Get a key at: https://resend.com/
RESEND_API_KEY=

# JWT secret for signing assessment session tokens (random 32+ char string)
ASSESSMENT_JWT_SECRET=

# Administrator password/secret (use a random value of at least 12 characters)
ADMIN_SECRET=

# Stripe payments and webhook verification
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_BASE_URL=https://jobsdata.ai

# LLM Analysis
# =======================
# Uses ANTHROPIC_API_KEY defined above for LLM data point extraction (~$0.10/run)

# Composite Model — AI Capability inputs
# =======================
# Artificial Analysis - frontier model benchmarks (quality, latency, price)
# Used by scripts/fetch-capability.ts to refresh AI Capability defaults on /model
# Get a key at: https://artificialanalysis.ai/
ARTIFICIAL_ANALYSIS_API_KEY=
